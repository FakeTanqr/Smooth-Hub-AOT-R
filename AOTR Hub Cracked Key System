					return "the GET remote"
				end
				local data = tbl[item] or (tostring(item) .. " Boost")
				local prev, out = callback(inst, "S_Equipment", "Talents")
				if not prev then
					Hub.out("[Smooth Hub] Prestige Talents call failed: " .. tostring(out))
				end
				task.wait(0.5)
				local cur, prev = update(out)
				if not cur then
					save("No Memory cards found - keeping the current pick")
					return "the Memory cards"
				end
				local tmp = apply(cur.Name)
				save("Picking card " .. cur.Name .. " ...")
				local res, val = callback(inst, "S_Equipment", "Prestige", { Talents = tmp, Boosts = data })
				if not res then
					Hub.out("[Smooth Hub] Prestige card call failed: " .. tostring(val))
					return "the card remote"
				end
				local now = os.clock()
				while os.clock() - now < 6 and isAlive() and Settings.AutoPrestige do
					if retry() or getPrestige() > obj or not loop() then
						return nil
					end
					task.wait(0.3)
				end
				return "the card remote (no response)"
			end
			local function handler(key)
				entry.Busy = true
				local tmp = getPrestige()
				local n = math.clamp(tmp + 1, 1, 5)
				local ok, err = pcall(function()
					if key <= 1 then
						save("Opening the Prestige page...")
						local function helper()
							local res = findChild("Interface", "Equipment")
							if not (res and findGuiAncestor(res)) then
								return findChild("Interface", "Topbar", "Main", "Categories", "Equipment", "Interact")
							end
							return findChild("Interface", "Equipment", "Categories", "Prestige", "Main", "Interact")
						end
						local function cb()
							local res = findChild("Interface", "Equipment", "Prestige", "B_Prestige")
							return (res and findGuiAncestor(res)) and res or nil
						end
						if not isAutoPrestige(helper, function()
							return cb() ~= nil
						end, 12) then
							return "the Prestige page"
						end
						save("Clicking PRESTIGE...")
						if not isAutoPrestige(cb, function()
							return resolve() ~= nil
						end, 10) then
							return "the PRESTIGE button"
						end
					end
					if key <= 3 then
						save("Confirming with YES...")
						if not isAutoPrestige(resolve, loop, 10) then
							return "the YES button"
						end
					end
					if key <= 4 then
						local val = Settings["PrestigeBoost" .. n] or "Luck"
						save(("Choosing %s boost (prestige #%d)..."):format(val, n))
						local res = step(val, tmp)
						if res then
							return res
						end
					end
					task.wait(0.8)
					save("Clicking FINISH...")
					local function helper()
						return not retry()
					end
					if not isAutoPrestige(function()
						return scan("FINISH")
					end, helper, 12) then
						return "the FINISH button"
					end
					return nil
				end)
				entry.Busy = false
				if not ok then
					save("Error: " .. tostring(err))
					return false
				end
				if err then
					save("Failed at: " .. err .. " (retrying in 30s)")
					return false
				end
				save(("Prestige done (now Prestige %d)"):format(getPrestige()))
				return true
			end
			task.spawn(function()
				local out, data = 0, 0
				while isAlive() do
					task.wait(1)
					data += 1
					if not Settings.AutoPrestige then
						entry.Pending = false
						if data % 5 == 0 then
							save("Off")
						end
					elseif not (InLobby or game.PlaceId == 14916516914) then
						entry.Pending = false
						save("Lobby place only")
					elseif not entry.Busy and os.clock() >= out then
						local prev = getPrestige()
						if prev >= (Settings.PrestigeStopAt or 1) then
							entry.Pending = false
							save(("Stopped: Prestige %d reached the target %d"):format(prev, Settings.PrestigeStopAt or 1))
						else
							local cur = nil
							local val, tmp = isA()
							if data % 5 == 0 and (val or entry.Pending or data <= 30) then
								if retry() then
									cur = 5
								elseif loop() then
									cur = 4
								elseif resolve() then
									cur = 3
								end
							end
							if not cur then
								if val then
									cur = 1
								else
									entry.Pending = false
									save(tmp or "Waiting for max level")
								end
							end
							if cur then
								entry.Pending = true
								local res = handler(cur)
								if res then
									entry.Pending = false
								end
								out = os.clock() + (res and 10 or 30)
							end
						end
					end
				end
			end)
		end
	end
