		function FarmModule.HoverRefill(opts)
			local RunService = game:GetService("RunService")
			local log = opts.log or function() end
			local char = LocalPlayer.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if not (hrp and hum and hum.Health > 0 and opts.stationPos and opts.remote and opts.isDone) then
				return false
			end
			local origin = hrp.Position
			local gap = FarmModule.RefillFireGap or 0.2
			local perRung = FarmModule.RefillRungTime or 3
			local speed = math.max(20, tonumber(FarmModule.RefillFlySpeed) or 150)
			local accel = math.max(40, tonumber(FarmModule.RefillFlyAccel) or 260)
			local rungs = {}
			for _, h in ipairs(FarmModule.RefillHoverHeights) do
