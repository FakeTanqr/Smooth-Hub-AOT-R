				return false
			end
			-- ---- ODM hooks: the script's own HookPress / HookRelease (Q + E, camera aimed at the point) ----
			local hooksOn, lastHook = false, 0
			local function hookDown(aimAt)
				if not FarmModule.RefillUseHooks or not FarmModule.HookPress then
					return
				end
				FarmModule.RefillHooks = true
				pcall(FarmModule.HookPress, aimAt)
