					local val = src[collect(apply(arg))]
					if val then
						opts[val] = true
					end
				elseif type(arg) == "table" then
					for i, v in pairs(arg) do
						run(i, src, opts, target + 1)
						run(v, src, opts, target + 1)
					end
				end
			end
			local function update(input)
				local out = {}
				for v, item in ipairs(Hub.Memories) do
					out[collect(apply(item.Name))] = item
					out[collect(item.Id)] = item
				end
				local prev = {}
				pcall(run, input, out, prev)
				for v, k in ipairs(walkDescendants()) do
					prev[k.mem] = true
				end
				local cur = {}
				for i in pairs(prev) do
					cur[#cur + 1] = i
				end
				if #cur == 0 then
					return nil
				end
				table.sort(cur, function(name, key)
					local val, tmp = Settings[name.Key] or 5, Settings[key.Key] or 5
					if val ~= tmp then
						return val > tmp
					end
					if name.Stars ~= key.Stars then
						return name.Stars > key.Stars
					end
					return name.Name < key.Name
				end)
				return cur[1], #cur
			end
