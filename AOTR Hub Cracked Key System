			local function flyTo(p, timeout)
				goal = p
				local t0 = os.clock()
				while os.clock() - t0 < timeout and isAlive() do
					local c = LocalPlayer.Character
					local r = c and c:FindFirstChild("HumanoidRootPart")
					if not r or hum.Health <= 0 then
						return false
					end
					if (r.Position - p).Magnitude <= 3 then
						return true
					end
					task.wait(0.05)
