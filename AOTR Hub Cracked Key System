		-- ===== Hover refill: fly (not teleport) above the station with the ODM hooks held, fire the remote every RefillFireGap until it refills =====
		-- UNCALIBRATED tuning values (not read from the game): change them if titans / raid boss skills still reach you, or if the server refuses
		FarmModule.RefillHoverHeights = { 150, 100, 60, 35 } -- studs above the station, highest first
		FarmModule.RefillFireGap = 0.2 -- seconds between remote fires
		FarmModule.RefillRungTime = 3.0 -- seconds spent firing at each height before stepping closer
