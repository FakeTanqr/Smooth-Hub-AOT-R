			local startAt = 1
			if FarmModule.RefillHoverOk then
				for i, h in ipairs(rungs) do
					if h == FarmModule.RefillHoverOk then
						startAt = i
						break
					end
				end
			end
			-- ---- flight controller: constant-acceleration flight, velocity always matches the real displacement, small hover drift ----
			local goal, vNow, conn = nil, 0, nil
			local flightStart = os.clock()
			local function stopFlight()
				if conn then
					conn:Disconnect()
					conn = nil
				end
			end
			local function startFlight()
				stopFlight()
				vNow = 0
				conn = RunService.Heartbeat:Connect(function(dt)
					local c = LocalPlayer.Character
					local r = c and c:FindFirstChild("HumanoidRootPart")
					if not r or not goal then
						return
					end
					dt = math.clamp(dt, 0.001, 0.1)
					local t = os.clock() - flightStart
					local target = goal + Vector3.new(math.sin(t * 1.1) * 1.2, math.sin(t * 1.7) * 0.6, math.cos(t * 0.9) * 1.2)
					local cur = r.Position
					local d = target - cur
					local dist = d.Magnitude
					if dist < 0.02 then
						vNow = 0
						return
					end
					local want = math.min(speed, math.sqrt(2 * accel * dist))
					vNow = vNow + math.clamp(want - vNow, -accel * dt, accel * dt)
					local stepLen = math.min(vNow * dt, dist)
					vNow = math.min(vNow, dist / dt)
					local dir = d / dist
					pcall(function()
						r.CFrame = CFrame.new(cur + dir * stepLen) * (r.CFrame - r.CFrame.Position)
						r.AssemblyLinearVelocity = dir * (stepLen / dt)
					end)
				end)
			end
			local function legTime(a, b)
				return (a - b).Magnitude / speed + 2.5
